{
  "name": "@x-shop/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Medusa v2 backend của x-shop (server + worker + Admin).",
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm --filter @x-shop/domain build && medusa build",
    "start": "medusa start -H \"${HOST:-127.0.0.1}\"",
    "dev": "medusa develop -H \"${HOST:-127.0.0.1}\"",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "seed:catalog": "medusa exec ./src/scripts/seed-catalog.ts",
    "catalog:reindex": "medusa exec ./src/scripts/rebuild-catalog-index.ts",
    "config:print": "ts-node --transpile-only -O \"{\\\"module\\\":\\\"commonjs\\\"}\" ./src/scripts/print-config.ts",
    "rbac:grant-owner": "medusa exec ./src/scripts/grant-owner.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json && tsc --noEmit -p src/admin/tsconfig.json",
    "test": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests",
    "test:coverage": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests --coverage",
    "test:integration": "TEST_TYPE=integration:http NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=3072\" jest --silent=false --maxWorkers=1 --forceExit",
    "test:integration:coverage": "TEST_TYPE=integration:http NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=3072\" jest --silent --maxWorkers=1 --forceExit --coverage --coverageDirectory=coverage-integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@medusajs/admin-sdk": "2.22.1",
    "@medusajs/admin-shared": "2.22.1",
    "@medusajs/cli": "2.22.1",
    "@medusajs/dashboard": "2.22.1",
    "@medusajs/draft-order": "2.22.1",
    "@medusajs/file-s3": "2.22.1",
    "@medusajs/framework": "2.22.1",
    "@medusajs/medusa": "2.22.1",
    "@medusajs/ui": "4.2.8",
    "@x-shop/domain": "workspace:*",
    "ioredis": "^5.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.22.1",
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "otpauth": "9.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=22.22.0 <23"
  }
}
