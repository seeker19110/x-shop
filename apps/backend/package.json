{
  "name": "@x-shop/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Medusa v2 backend của x-shop (server + worker + Admin).",
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm --filter @x-shop/domain build && medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "seed:catalog": "medusa exec ./src/scripts/seed-catalog.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests",
    "test:integration": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.22.1",
    "@medusajs/admin-shared": "2.22.1",
    "@medusajs/cli": "2.22.1",
    "@medusajs/dashboard": "2.22.1",
    "@medusajs/draft-order": "2.22.1",
    "@medusajs/framework": "2.22.1",
    "@medusajs/medusa": "2.22.1",
    "@x-shop/domain": "workspace:*",
    "ioredis": "^5.8.2",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.22.1",
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=22.22.0 <23"
  }
}
