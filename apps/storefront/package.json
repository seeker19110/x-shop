{
  "name": "@x-shop/storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev -H \"${HOST:-127.0.0.1}\"",
    "build": "pnpm --filter @x-shop/domain build && NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start -H \"${HOST:-127.0.0.1}\"",
    "typecheck": "pnpm --filter @x-shop/domain build && tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:coverage": "node scripts/test.mjs --coverage"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@x-shop/domain": "workspace:*",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
