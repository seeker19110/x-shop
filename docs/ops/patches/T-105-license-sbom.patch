+test("checkPolicy: thiếu trường, quá hạn, xa quá 180 ngày, ngày sai, deny/Unknown thiếu decision, trùng allow-deny", () => {
+  const bad = (exceptions) => checkPolicy({ ...policy, exceptions }, NOW);
+  assert.deepEqual(bad([exc({})]), []);
+  assert.match(bad([exc({ reason: "" })])[0], /thiếu reason/);
+  assert.match(bad([exc({ approved_by: undefined })])[0], /thiếu approved_by/);
+  assert.match(bad([exc({ expires: "2026-10-01" })])[0], /hết hạn/);
+  assert.match(bad([exc({ expires: "2028-01-01" })])[0], /xa quá 180/);
+  assert.match(bad([exc({ expires: "01/01/2027" })])[0], /YYYY-MM-DD/);
+  assert.match(bad([exc({ license: "Unknown" })])[0], /decision/);
+  assert.match(bad([exc({ license: "AGPL-3.0-only" })])[0], /decision/);
+  assert.match(bad([exc({}), exc({})])[0], /trùng/);
+  assert.match(checkPolicy({ ...policy, deny: ["MIT"] }, NOW)[0], /vừa ở allow vừa ở deny/);
+  assert.match(checkPolicy({ allow: [] }, NOW)[0], /thiếu danh sách/);
+  assert.match(checkPolicy({ ...policy, exceptions: [exc({ versions: "1" })] }, NOW).join(), /versions/);
+});
