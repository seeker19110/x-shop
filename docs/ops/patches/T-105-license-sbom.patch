+test("evaluate: gói review/unknown/deny không ngoại lệ → vi phạm; có ngoại lệ đúng chuỗi → đạt; sai chuỗi/phiên bản/hết hạn → vi phạm", () => {
+  const pkgs = [
+    { name: "ok", version: "1.0.0", license: "MIT" },
+    { name: "p", version: "1.0.0", license: "MPL-2.0" },
+    { name: "q", version: "1.0.0", license: "Unknown" },
+    { name: "agpl", version: "1.0.0", license: "AGPL-3.0-only" },
+  ];
+  const r0 = evaluate(pkgs, policy, NOW);
+  assert.deepEqual(
+    r0.violations.map((v) => v.name),
+    ["p", "q", "agpl"],
+  );
+  const withExc = {
+    ...policy,
+    exceptions: [exc({}), exc({ package: "q", license: "Unknown", decision: "D-1" })],
+  };
+  const r1 = evaluate(pkgs, withExc, NOW);
+  assert.deepEqual(
+    r1.violations.map((v) => v.name),
+    ["agpl"],
+  );
+  assert.equal(r1.excepted.length, 2);
+  // sai chuỗi giấy phép (gói đổi giấy phép) → ngoại lệ không còn hiệu lực
+  assert.equal(
+    evaluate([{ name: "p", version: "1.0.0", license: "GPL-3.0-only" }], withExc, NOW).violations.length,
+    1,
+  );
+  // giới hạn phiên bản
+  const v = { ...policy, exceptions: [exc({ versions: ["1.0.0"] })] };
+  assert.equal(evaluate([{ name: "p", version: "2.0.0", license: "MPL-2.0" }], v, NOW).violations.length, 1);
+  assert.equal(evaluate([{ name: "p", version: "1.0.0", license: "MPL-2.0" }], v, NOW).violations.length, 0);
+  // hết hạn
+  const old = { ...policy, exceptions: [exc({ expires: "2026-10-25" })] };
+  assert.equal(evaluate([pkgs[1]], old, NOW).violations.length, 1);
+  // ngoại lệ hết hạn đúng ngày hôm nay vẫn còn hiệu lực tới hết ngày (UTC)
+  const today = { ...policy, exceptions: [exc({ expires: "2026-10-26" })] };
+  assert.equal(evaluate([pkgs[1]], today, new Date("2026-10-26T12:00:00Z")).violations.length, 0);
+  // ngoại lệ không còn khớp gói nào → stale
+  assert.equal(evaluate([pkgs[0]], withExc, NOW).stale.length, 2);
+  // rỗng
+  assert.deepEqual(evaluate([], policy, NOW).violations, []);
+});
