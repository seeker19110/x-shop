+test("buildSbom: CycloneDX 1.6, purl có scope mã hoá, expression/id/name, Unknown không có licenses, ghi SHA; coverage", () => {
+  const sbom = buildSbom(
+    [
+      { name: "@scope/pkg", version: "1.0.0", license: "MIT" },
+      { name: "dual", version: "1.0.0", license: "(MIT OR CC0-1.0)" },
