+test("classifyExpression: OR lấy nhánh tốt nhất, AND nhánh xấu nhất, ngoặc, glob deny, định danh lạ = không rõ", () => {
+  const c = (e) => classifyExpression(e, policy);
+  assert.equal(c("MIT"), "allow");
+  assert.equal(c("(MIT OR CC0-1.0)"), "allow");
+  assert.equal(c("MIT OR GPL-3.0-only"), "allow");
+  assert.equal(c("MIT AND GPL-3.0-only"), "deny");
+  assert.equal(c("Apache-2.0 AND MIT"), "allow");
+  assert.equal(c("MIT AND MPL-2.0"), "review");
+  assert.equal(c("AGPL-3.0-or-later"), "deny");
+  assert.equal(c("BUSL-1.1"), "source_available");
+  assert.equal(c("SSPL-1.0 OR AGPL-3.0-only"), "source_available");
+  assert.equal(c("Weird-1.0"), "unknown");
+  assert.equal(c("(MIT"), "unknown");
+  assert.equal(c(""), "unknown");
+  assert.equal(c("GPL-2.0+"), "deny");
+});
