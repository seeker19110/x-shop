@@ -0,0 +1,204 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import {
+  buildSbom,
+  checkAllowSync,
+  checkPolicy,
+  classifyExpression,
+  creditGlobs,
+  evaluate,
+  flattenPnpm,
+  globToRegExp,
+  isUnknownLicense,
+  licenseCoverage,
+  parseExpression,
+  uncreditedAssets,
+} from "./licenses.mjs";
+
+const NOW = new Date("2026-10-26T00:00:00Z");
+const policy = {
+  allow: ["MIT", "Apache-2.0", "ISC", "CC0-1.0"],
+  review: ["MPL-2.0"],
+  deny: ["AGPL-*", "GPL-*"],
+  source_available: ["BUSL-1.1", "SSPL-1.0"],
+  exceptions: [],
+};
+const exc = (o) => ({
+  package: "p",
+  license: "MPL-2.0",
+  reason: "r",
+  approved_by: "a",
+  expires: "2027-01-01",
+  ...o,
+});
+
+test("isUnknownLicense: rỗng/null/Unknown/UNLICENSED/SEE LICENSE đều là không rõ; MIT thì không", () => {
+  for (const s of [
+    "",
+    null,
+    undefined,
+    "Unknown",
+    "UNLICENSED",
+    "see license in LICENSE.md",
+    "NOASSERTION",
+    "  ",
