new file mode 100644
index 0000000..c4823fc
--- /dev/null
+++ b/scripts/licenses.mjs
@@ -0,0 +1,376 @@
+#!/usr/bin/env node
+// Cổng giấy phép phụ thuộc + asset (BASE-DEP-005, CMP-LIC-002/003/004). Đọc `license-policy.yaml`, quét phụ thuộc đã cài
+// bằng `pnpm licenses list --json` (hoặc `--input <file>` cho test), và ĐỎ khi có gói: giấy phép deny / source-available /
+// cần rà / không rõ mà không có ngoại lệ còn hạn (`package`, `license`, `reason`, `approved_by`, `expires`). Kiểm thêm:
+// ngoại lệ quá hạn, thiếu trường, `expires` xa quá 180 ngày, ngoại lệ deny/source-available/Unknown thiếu `decision`,
+// `license-allow.json` ⊆ `allow` của chính sách, và mọi ảnh/phông trong thư mục asset phải có dòng ở `assets/CREDITS.md`.
+// `--sbom <file>` ghi SBOM CycloneDX 1.6 (CMP-LIC-003) và đỏ nếu < 99% thành phần có giấy phép.
+// CLI: node scripts/licenses.mjs [--policy F] [--input F] [--sbom F] [--credits F] [--no-assets]
+import { execFileSync } from "node:child_process";
+import { existsSync, readdirSync, readFileSync, writeFileSync } from "node:fs";
+import { join, relative, resolve } from "node:path";
+import { pathToFileURL } from "node:url";
+import { parse } from "yaml";
+
+export const MAX_EXCEPTION_DAYS = 180;
+export const MIN_LICENSE_COVERAGE = 0.99;
+const DAY = 86_400_000;
+const RANK = { allow: 0, review: 1, unknown: 2, source_available: 3, deny: 4 };
+const ASSET_DIRS = ["apps/storefront/public", "apps/backend/static", "assets"];
+const ASSET_EXT = /\.(svg|png|jpe?g|webp|avif|gif|ico|woff2?|ttf|otf|mp4|webm|mp3|wav)$/i;
+const REQUIRED = ["package", "license", "reason", "approved_by", "expires"];
+
+/** Chuỗi giấy phép "không rõ": rỗng, Unknown, UNLICENSED, SEE LICENSE IN …, NOASSERTION. */
+export function isUnknownLicense(s) {
+  const t = String(s ?? "").trim();
+  return !t || /^(unknown|unlicensed|noassertion|none)$/i.test(t) || /^see license/i.test(t);
+}
+
+const matchesAny = (id, patterns) =>
+  (patterns ?? []).some((p) => (p.endsWith("*") ? id.startsWith(p.slice(0, -1)) : id === p));
+
+/** Phân loại MỘT định danh SPDX → allow | review | unknown | source_available | deny. Hậu tố `+` bỏ khi tra. */
+export function classifyId(id, policy) {
+  const bare = id.replace(/\+$/, "");
+  if (isUnknownLicense(id)) return "unknown";
+  if (matchesAny(id, policy.source_available) || matchesAny(bare, policy.source_available))
+    return "source_available";
+  if (matchesAny(id, policy.deny) || matchesAny(bare, policy.deny)) return "deny";
+  if (policy.allow?.includes(id)) return "allow";
+  if (policy.review?.includes(id)) return "review";
+  return "unknown"; // định danh lạ (chưa phân loại) = chưa rõ, không bao giờ tự cho qua
+}
+
+/** Tách biểu thức SPDX thành cây: {op:"OR"|"AND", args} | {id}. Ngoặc không khớp → ném lỗi. */
+export function parseExpression(expr) {
+  const tokens = String(expr).match(/\(|\)|[^\s()]+/g) ?? [];
+  let i = 0;
+  const parseOr = () => {
+    const args = [parseAnd()];
+    while (tokens[i]?.toUpperCase() === "OR") {
+      i++;
+      args.push(parseAnd());
+    }
+    return args.length === 1 ? args[0] : { op: "OR", args };
+  };
+  const parseAnd = () => {
+    const args = [parseAtom()];
+    while (tokens[i]?.toUpperCase() === "AND") {
+      i++;
+      args.push(parseAtom());
+    }
+    return args.length === 1 ? args[0] : { op: "AND", args };
+  };
+  const parseAtom = () => {
+    const t = tokens[i++];
+    if (t === undefined) throw new Error(`biểu thức SPDX cụt: "${expr}"`);
+    if (t === "(") {
+      const n = parseOr();
+      if (tokens[i++] !== ")") throw new Error(`thiếu ")" trong "${expr}"`);
+      return n;
+    }
+    if (t === ")" || /^(AND|OR)$/i.test(t)) throw new Error(`token lạ "${t}" trong "${expr}"`);
+    return { id: t };
+  };
+  const tree = parseOr();
+  if (i < tokens.length) throw new Error(`thừa token "${tokens[i]}" trong "${expr}"`);
+  return tree;
+}
+
+/** Mức xấu nhất/tốt nhất của biểu thức: OR lấy nhánh tốt nhất, AND lấy nhánh xấu nhất. Không phân tích được → unknown. */
+export function classifyExpression(expr, policy) {
+  if (isUnknownLicense(expr)) return "unknown";
+  let tree;
+  try {
+    tree = parseExpression(expr);
+  } catch {
+    return "unknown";
+  }
+  const walk = (n) => {
+    if (n.id !== undefined) return classifyId(n.id, policy);
+    const levels = n.args.map(walk);
+    const pick = n.op === "OR" ? Math.min : Math.max;
+    const r = pick(...levels.map((l) => RANK[l]));
+    return Object.keys(RANK).find((k) => RANK[k] === r);
+  };
+  return walk(tree);
+}
+
+/** Kiểm chính sách + ngoại lệ; trả mảng lỗi (rỗng = đạt). */
+export function checkPolicy(policy, now = new Date()) {
+  const errors = [];
+  for (const k of ["allow", "review", "deny", "source_available"]) {
+    if (!Array.isArray(policy?.[k])) errors.push(`license-policy.yaml: thiếu danh sách \`${k}\``);
+  }
+  const lists = ["allow", "review", "deny", "source_available"];
+  for (const id of policy?.allow ?? []) {
+    for (const k of lists.slice(1)) {
+      if (matchesAny(id, policy[k] ?? [])) errors.push(`SPDX \`${id}\` vừa ở allow vừa ở ${k}`);
+    }
+  }
+  const seen = new Set();
+  for (const [i, e] of (policy?.exceptions ?? []).entries()) {
+    const tag = `ngoại lệ #${i + 1} (${e?.package ?? "?"})`;
+    const missing = REQUIRED.filter((k) => typeof e?.[k] !== "string" || !e[k].trim());
+    if (missing.length) {
+      errors.push(`${tag}: thiếu ${missing.join(", ")}`);
+      continue;
+    }
+    const key = `${e.package}|${e.license}|${[e.versions ?? []].flat().join(",")}`;
+    if (seen.has(key)) errors.push(`${tag}: trùng lặp`);
+    seen.add(key);
+    if (!/^\d{4}-\d{2}-\d{2}$/.test(e.expires) || Number.isNaN(Date.parse(e.expires))) {
+      errors.push(`${tag}: expires "${e.expires}" không phải YYYY-MM-DD`);
+      continue;
+    }
+    const days = Math.floor((Date.parse(`${e.expires}T23:59:59Z`) - now.getTime()) / DAY);
+    if (days < 0) errors.push(`${tag}: hết hạn ${e.expires} — xét lại rồi gia hạn hoặc bỏ gói`);
+    else if (days > MAX_EXCEPTION_DAYS)
+      errors.push(`${tag}: expires ${e.expires} xa quá ${MAX_EXCEPTION_DAYS} ngày`);
+    if (
+      e.versions !== undefined &&
+      (!Array.isArray(e.versions) || e.versions.some((v) => typeof v !== "string"))
+    ) {
+      errors.push(`${tag}: versions phải là danh sách chuỗi`);
+    }
+    const level = classifyExpression(e.license, policy);
+    if (["deny", "source_available", "unknown"].includes(level) && !String(e.decision ?? "").trim()) {
+      errors.push(`${tag}: giấy phép ${level} (${e.license}) bắt buộc có \`decision\` (D-NNN/ADR)`);
+    }
+  }
+  return errors;
+}
+
+/** `license-allow.json` (cổng Python của khung) phải là tập con `allow` của chính sách. */
+export function checkAllowSync(policy, allowJson) {
+  const errors = [];
+  if (!Array.isArray(allowJson?.allow)) return ["license-allow.json: thiếu `allow`"];
+  for (const id of allowJson.allow) {
+    if (!policy.allow?.includes(id))
+      errors.push(`license-allow.json: \`${id}\` không có trong allow của license-policy.yaml`);
+  }
+  return errors;
+}
+
+/** Làm phẳng đầu ra `pnpm licenses list --json` ({license: [{name, versions, license, ...}]}) → [{name, version, license}]. */
+export function flattenPnpm(json) {
+  const out = [];
+  for (const [group, pkgs] of Object.entries(json ?? {})) {
+    for (const p of pkgs ?? []) {
+      const versions = p.versions?.length ? p.versions : [p.version ?? ""];
+      for (const version of versions) out.push({ name: p.name, version, license: p.license ?? group });
+    }
+  }
+  return out.sort((a, b) => a.name.localeCompare(b.name) || a.version.localeCompare(b.version));
+}
+
+/** Ngoại lệ còn hạn khớp gói (tên + đúng chuỗi giấy phép + phiên bản nếu có giới hạn). */
+export function findException(pkg, policy, now = new Date()) {
+  return (policy.exceptions ?? []).find(
+    (e) =>
+      e.package === pkg.name &&
+      e.license === pkg.license &&
+      (!e.versions || e.versions.includes(pkg.version)) &&
+      Date.parse(`${e.expires}T23:59:59Z`) >= now.getTime(),
+  );
+}
+
+/** Đánh giá toàn bộ gói. {violations, excepted, stale, counts}. */
+export function evaluate(packages, policy, now = new Date()) {
+  const violations = [];
+  const excepted = [];
+  const counts = { allow: 0, review: 0, unknown: 0, source_available: 0, deny: 0 };
+  const used = new Set();
+  for (const p of packages) {
+    const level = classifyExpression(p.license, policy);
+    counts[level]++;
+    if (level === "allow") continue;
+    const exc = findException(p, policy, now);
+    if (exc) {
+      used.add(exc);
+      excepted.push({ ...p, level, exception: exc });
+    } else {
+      violations.push({ ...p, level });
+    }
+  }
+  const stale = (policy.exceptions ?? []).filter((e) => !used.has(e));
+  return { violations, excepted, stale, counts };
+}
+
+const stripExt = (s) => String(s).trim();
+const isSpdxLike = (s) =>
+  /^[A-Za-z0-9.+()\- ]+$/.test(s) && !isUnknownLicense(s) && (!/ /.test(s) || / (AND|OR) /.test(s));
+
+/** SBOM CycloneDX 1.6. License là `expression` khi giống SPDX, ngược lại `license.name`; Unknown → không có trường. */
+export function buildSbom(packages, { name, version, sha, now = new Date() } = {}) {
+  const components = packages.map((p) => {
+    const group = p.name.startsWith("@") ? p.name.split("/")[0] : undefined;
+    const bare = group ? p.name.slice(group.length + 1) : p.name;
+    const purl = `pkg:npm/${group ? `${encodeURIComponent(group)}/` : ""}${encodeURIComponent(bare)}@${encodeURIComponent(p.version)}`;
+    const c = {
+      type: "library",
+      "bom-ref": purl,
+      ...(group ? { group } : {}),
+      name: bare,
+      version: p.version,
+      purl,
+    };
+    const lic = stripExt(p.license);
+    if (!isUnknownLicense(lic)) {
+      c.licenses =
+        isSpdxLike(lic) && /[A-Za-z]/.test(lic) && /(\bOR\b|\bAND\b|\()/.test(lic)
+          ? [{ expression: lic }]
+          : [{ license: isSpdxLike(lic) ? { id: lic } : { name: lic } }];
+    }
+    return c;
+  });
+  return {
+    bomFormat: "CycloneDX",
+    specVersion: "1.6",
+    version: 1,
+    metadata: {
+      timestamp: now.toISOString(),
+      component: {
+        type: "application",
+        name: name ?? "x-shop",
+        version: version ?? "0.0.0",
+        ...(sha ? { "bom-ref": `git:${sha}` } : {}),
+      },
+      ...(sha ? { properties: [{ name: "git.commit", value: sha }] } : {}),
+    },
+    components,
+  };
+}
+
+export function licenseCoverage(sbom) {
+  const n = sbom.components.length;
+  const withLic = sbom.components.filter((c) => c.licenses?.length).length;
+  return { total: n, withLicense: withLic, ratio: n === 0 ? 0 : withLic / n };
+}
+
+// ---- asset --------------------------------------------------------------------------------------------------------
+
+/** Glob đường dẫn → RegExp: `**` mọi cấp, `*` trong một cấp, `{a,b}` chọn. */
+export function globToRegExp(glob) {
+  let re = "";
+  for (let i = 0; i < glob.length; i++) {
+    const c = glob[i];
+    if (c === "*" && glob[i + 1] === "*") {
+      re += ".*";
+      i++;
+    } else if (c === "*") re += "[^/]*";
+    else if (c === "{") re += "(?:";
+    else if (c === "}") re += ")";
+    else if (c === ",") re += "|";
+    else re += c.replace(/[.+?^$()|[\]\\]/g, "\\$&");
+  }
+  return new RegExp(`^${re}$`);
+}
+
+/** Glob đường dẫn ở cột đầu của bảng CREDITS.md (chỉ ô bắt đầu bằng `apps/`/`assets/`/`packages/` trong dấu huyền). */
+export function creditGlobs(markdown) {
+  const globs = [];
+  for (const line of String(markdown ?? "").split(/\r?\n/)) {
+    if (!line.startsWith("|")) continue;
+    const first = line.split("|")[1] ?? "";
+    for (const m of first.matchAll(/`([^`]+)`/g)) {
+      if (/^(apps|assets|packages)\//.test(m[1])) globs.push(m[1]);
+    }
+  }
+  return globs;
+}
+
+/** File asset (ảnh/phông/media) chưa có glob nào trong CREDITS.md → danh sách đường dẫn. */
+export function uncreditedAssets(files, globs) {
+  const res = globs.map(globToRegExp);
+  return files.filter((f) => ASSET_EXT.test(f) && !res.some((r) => r.test(f)));
+}
+
+function walk(dir, root, out = []) {
+  if (!existsSync(dir)) return out;
+  for (const d of readdirSync(dir, { withFileTypes: true })) {
+    const full = join(dir, d.name);
+    if (d.isDirectory()) walk(full, root, out);
+    else out.push(relative(root, full).split("\\").join("/"));
+  }
+  return out;
+}
+
+// ---- CLI ----------------------------------------------------------------------------------------------------------
+
+function arg(argv, name, dflt) {
+  const i = argv.indexOf(name);
+  return i >= 0 ? argv[i + 1] : dflt;
+}
+
+export function main(argv = process.argv.slice(2), root = process.cwd()) {
+  const policyPath = resolve(root, arg(argv, "--policy", "license-policy.yaml"));
+  const now = new Date();
+  const errors = [];
+  const policy = parse(readFileSync(policyPath, "utf8"));
+  errors.push(...checkPolicy(policy, now));
+  const allowPath = join(root, "license-allow.json");
+  if (existsSync(allowPath))
+    errors.push(...checkAllowSync(policy, JSON.parse(readFileSync(allowPath, "utf8"))));
+
+  const input = arg(argv, "--input");
+  const raw = input
+    ? readFileSync(resolve(root, input), "utf8")
+    : execFileSync("pnpm", ["licenses", "list", "--json"], {
+        cwd: root,
+        encoding: "utf8",
+        maxBuffer: 512 * 1024 * 1024,
+      });
+  const packages = flattenPnpm(JSON.parse(raw));
+  if (packages.length === 0) errors.push("không quét được gói nào (đã chạy `pnpm install` chưa?)");
+  const res = evaluate(packages, policy, now);
+  for (const v of res.violations) {
+    errors.push(`${v.name}@${v.version}: giấy phép \`${v.license}\` (${v.level}) không có ngoại lệ còn hạn`);
+  }
+  for (const s of res.stale)
+    console.warn(`cảnh báo: ngoại lệ ${s.package} (${s.license}) không còn khớp gói nào — bỏ đi`);
+
+  const sbomPath = arg(argv, "--sbom");
+  if (sbomPath) {
+    const sha = process.env.GITHUB_SHA || tryGit(root);
+    const pkgJson = JSON.parse(readFileSync(join(root, "package.json"), "utf8"));
+    const sbom = buildSbom(packages, { name: pkgJson.name, version: pkgJson.version, sha, now });
+    writeFileSync(resolve(root, sbomPath), `${JSON.stringify(sbom, null, 2)}\n`);
+    const cov = licenseCoverage(sbom);
+    console.log(`SBOM ${sbomPath}: ${cov.total} thành phần, ${(cov.ratio * 100).toFixed(2)}% có giấy phép`);
+    if (cov.ratio < MIN_LICENSE_COVERAGE)
+      errors.push(`SBOM: chỉ ${(cov.ratio * 100).toFixed(2)}% có giấy phép (< 99%)`);
+  }
+
+  if (!argv.includes("--no-assets")) {
+    const creditsPath = resolve(root, arg(argv, "--credits", "assets/CREDITS.md"));
+    if (!existsSync(creditsPath)) errors.push("thiếu assets/CREDITS.md (nguồn + giấy phép asset)");
+    else {
+      const globs = creditGlobs(readFileSync(creditsPath, "utf8"));
+      const files = ASSET_DIRS.flatMap((d) => walk(join(root, d), root));
+      for (const f of uncreditedAssets(files, globs))
+        errors.push(`asset ${f}: chưa có dòng trong assets/CREDITS.md`);
+    }
+  }
+
+  console.log(
+    `licenses: ${packages.length} gói — allow ${res.counts.allow}, review ${res.counts.review}, không rõ ${res.counts.unknown}, ` +
+      `source-available ${res.counts.source_available}, deny ${res.counts.deny}; ngoại lệ đang dùng ${res.excepted.length}.`,
+  );
+  if (errors.length) {
+    for (const e of errors) console.error(`✗ ${e}`);
+    return 1;
+  }
+  console.log("✓ licenses: đạt chính sách.");
+  return 0;
+}
+
+function tryGit(root) {
+  try {
+    return execFileSync("git", ["rev-parse", "HEAD"], { cwd: root, encoding: "utf8" }).trim();
+  } catch {
+    return undefined;
+  }
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) process.exit(main());
