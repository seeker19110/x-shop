+  assert.equal(sbom.components[3].licenses, undefined);
+  assert.equal(sbom.metadata.properties[0].value, "abc123");
+  assert.deepEqual(licenseCoverage(sbom), { total: 4, withLicense: 3, ratio: 0.75 });
+  assert.equal(licenseCoverage({ components: [] }).ratio, 0);
+});
