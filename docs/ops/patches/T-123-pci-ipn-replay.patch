+/** Kết quả kiểm cửa sổ thời gian của IPN (chống phát lại/giả mạo theo `vnp_PayDate`, IND-ECOM-006, T-123). */
+export type PayDateCheck = "ok" | "missing" | "before_attempt" | "future";
+
+/**
+ * Cửa sổ hợp lệ của `vnp_PayDate` cho một IPN đã qua chữ ký: `[attemptCreatedAt − skew, now + skew]`.
+ * - `missing`: thiếu/sai định dạng (verifyNotification trả `payDate: null`).
+ * - `before_attempt`: giao dịch "trả" trước khi payment attempt (txnRef) tồn tại — không thể là của attempt này.
+ * - `future`: thời điểm trả ở tương lai so với đồng hồ máy chủ quá `skew` — giả mạo hoặc lệch giờ.
+ * KHÔNG có cận "quá cũ": IPN trễ (tiền đến sau khi đơn hết hạn/hủy, AT09) vẫn phải ghi nhận; phát lại đúng một IPN cũ đã
+ * bị chặn bởi khoá sự kiện (inbox) + UNIQUE bút toán. `skewMs` ≥ 0, số nguyên.
+ */
+export function checkPayDateWindow(
+  payDate: Date | null,
+  w: { attemptCreatedAt: Date; now: Date; skewMs: number },
+): PayDateCheck {
+  if (!Number.isSafeInteger(w.skewMs) || w.skewMs < 0) throw new Error("skewMs phải là số nguyên ≥ 0");
+  if (!payDate || Number.isNaN(payDate.getTime())) return "missing";
+  const t = payDate.getTime();
+  if (t < w.attemptCreatedAt.getTime() - w.skewMs) return "before_attempt";
+  if (t > w.now.getTime() + w.skewMs) return "future";
+  return "ok";
+}
