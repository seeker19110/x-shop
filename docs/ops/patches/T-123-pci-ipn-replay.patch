     });
     return response;
   }
-  return processVerified(container, verified.value, "ipn", sanitize(query));
+  const payload = sanitize(query);
+  const outOfWindow = await rejectOutOfWindow(container, verified.value, payload);
+  if (outOfWindow) return outOfWindow;
+  return processVerified(container, verified.value, "ipn", payload);
+}
+
+/**
+ * Chống phát lại/giả mạo theo thời gian (T-123): IPN đã qua chữ ký nhưng `vnp_PayDate` thiếu, trước khi attempt tồn tại
+ * hoặc ở tương lai (`vnpay.checkPayDateWindow`) → KHÔNG đổi trạng thái tiền: ghi inbox `rejected:<băm>` (lý do
+ * `pay_date_*`), mở ngoại lệ `webhook_rejected`, trả 99 (VNPAY gửi lại — lệch giờ tạm thời tự hết). Tiền thật không mất:
+ * querydr (nút "Kiểm tra lại", job hết hạn) vẫn là đường xác nhận độc lập. Chỉ áp cho IPN (nguồn trình duyệt/mạng
+ * ngoài), không cho kết quả querydr do máy chủ tự hỏi. Không có attempt → để processVerified trả 01 như cũ.
+ */
+async function rejectOutOfWindow(
+  container: MedusaContainer,
+  n: vnpay.VerifiedNotification,
+  payload: Record<string, string>,
+): Promise<IpnResponse | null> {
+  const s = service(container);
+  const [attempt] = await s.listPaymentAttempts({ txn_ref: n.txnRef, provider: PROVIDER });
+  if (!attempt) return null;
+  const check = vnpay.checkPayDateWindow(n.payDate, {
+    attemptCreatedAt: new Date(attempt.created_at),
+    now: new Date(),
+    skewMs: CHECKOUT_CONFIG.ipnPayDateSkewMs,
+  });
+  if (check === "ok") return null;
+  const reason = `pay_date_${check}`;
+  const hash = payloadHash(payload);
+  const inbox = await s.recordInbox({
+    provider: PROVIDER,
+    event_key: `rejected:${hash}`,
+    source: "ipn",
+    payload,
+    payload_hash: hash,
+    verified: true,
+  });
+  await s.markInboxProcessed(inbox.id, { ...R.unknownError, reason });
+  await s.openOpsException({
+    kind: "webhook_rejected",
+    dedupe_key: `${reason}:${PROVIDER}:${hash}`,
+    order_id: attempt.order_id,
+    amount: n.amount,
+    priority: "high",
+    detail: {
+      reason,
+      txn_ref: n.txnRef,
+      transaction_no: n.transactionNo || null,
+      pay_date: payload.vnp_PayDate ?? null,
+      attempt_created_at: new Date(attempt.created_at).toISOString(),
+    },
+  });
+  return R.unknownError;
 }
 
