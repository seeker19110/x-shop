+/**
+ * Tham số KHÔNG được lưu bền cùng URL thanh toán (D-049): `vnp_IpAddr` = IP khách (dữ liệu cá nhân) và chữ ký — HMAC
+ * tính trên tham số có IP, giữ lại thì ai có khoá vẫn dò lại được IPv4 (2^32 lần thử).
+ */
+const UNSTORED_PAYMENT_PARAMS: ReadonlySet<string> = new Set([
+  "vnp_IpAddr",
+  "vnp_SecureHash",
+  "vnp_SecureHashType",
+]);
+
+/** Giải mã một thành phần query kiểu form (`+` = khoảng trắng) — ngược của `vnpEncode`. */
+function formDecode(s: string): string {
+  return decodeURIComponent(s.replace(/\+/g, " "));
+}
+
+function splitPaymentUrl(url: string): { base: string; parts: string[] } {
+  const q = url.indexOf("?");
+  if (q <= 0) throw new Error("URL thanh toán VNPAY không hợp lệ (thiếu query)");
+  const query = url.slice(q + 1);
+  return { base: url.slice(0, q), parts: query === "" ? [] : query.split("&") };
+}
+
+function keyOf(part: string): string {
+  const eq = part.indexOf("=");
+  return formDecode(eq === -1 ? part : part.slice(0, eq));
+}
+
+/**
+ * Bản lưu bền của URL thanh toán (`payment_attempt.payment_url`, D-049): bỏ `vnp_IpAddr` và chữ ký, giữ nguyên từng
+ * thành phần còn lại như đã gửi (cùng chuỗi đã encode). Bản lưu KHÔNG dùng được để thanh toán — trả khách phải qua
+ * `signStoredPaymentUrl`. Gọi lại trên bản lưu cho cùng kết quả (idempotent).
+ */
+export function toStoredPaymentUrl(paymentUrl: string): string {
+  const { base, parts } = splitPaymentUrl(paymentUrl);
+  const kept = parts.filter((p) => p !== "" && !UNSTORED_PAYMENT_PARAMS.has(keyOf(p)));
+  return `${base}?${kept.join("&")}`;
+}
+
