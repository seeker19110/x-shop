+export function signStoredPaymentUrl(
+  cfg: Pick<VnpayConfig, "hashSecret">,
+  storedUrl: string,
+  ipAddr: string,
+): string {
+  if (typeof ipAddr !== "string" || ipAddr.trim() === "" || ipAddr.length > 64)
+    throw new Error("ipAddr không hợp lệ");
+  const { base, parts } = splitPaymentUrl(storedUrl);
+  const params: Record<string, string> = {};
+  for (const part of parts) {
