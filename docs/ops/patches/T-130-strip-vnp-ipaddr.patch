+import { Migration } from "@medusajs/framework/mikro-orm/migrations";
+
+/**
+ * Câu lệnh làm sạch, dùng chung với test tích hợp: bỏ `vnp_IpAddr` (IP khách thô), `vnp_SecureHash`/`vnp_SecureHashType`
+ * (HMAC tính trên tham số có IP — giữ lại thì ai có khoá dò lại được IPv4) khỏi `payment_attempt.payment_url`; dọn `&`/`?`
+ * thừa ở cuối. Kết quả trùng `vnpay.toStoredPaymentUrl` của packages/domain cho URL do `buildPaymentUrl` tạo. Chạy lại
+ * không đổi gì (WHERE chỉ khớp dòng còn tham số cần bỏ). Không đụng `updated_at` (job/đối soát đọc cột này).
+ */
+export const REDACT_PAYMENT_URL_SQL = `update "payment_attempt"
+  set "payment_url" = regexp_replace(
+    regexp_replace("payment_url", '(?<=[?&])vnp_(IpAddr|SecureHash|SecureHashType)=[^&]*(&|$)', '', 'g'),
+    '&$', '')
+  where "payment_url" ~ '[?&]vnp_(IpAddr|SecureHash|SecureHashType)=';`;
