{
  "name": "x-shop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p e2e/tsconfig.json",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm -r --if-present test:integration",
    "coverage:ratchet": "node scripts/coverage-ratchet.mjs",
    "coverage:ratchet:test": "node --test scripts/coverage-ratchet.test.mjs",
    "build": "pnpm -r --if-present build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "perf:budget": "bash scripts/perf/run-budget.sh",
    "load:smoke": "node scripts/load/smoke.mjs",
    "load:test": "node --test scripts/load/*.test.mjs scripts/perf/*.test.mjs",
    "e2e": "node e2e/run.mjs",
    "e2e:smoke": "node e2e/run.mjs --grep @smoke",
    "e2e:smoke:test": "node --test e2e/smoke-tags.test.mjs",
    "lint:openapi": "spectral lint docs/design/openapi.yaml --ruleset .spectral.yaml --fail-severity=warn",
    "check:openapi": "node scripts/check-openapi.mjs && pnpm lint:openapi",
    "check:openapi:test": "node --test scripts/check-openapi.test.mjs",
    "check:authz": "node scripts/check-authz-tests.mjs",
    "check:authz:test": "node --test scripts/check-authz-tests.test.mjs",
    "check:data-map": "node scripts/check-data-map.mjs",
    "check:data-map:test": "node --test scripts/check-data-map.test.mjs",
    "check:adr": "node scripts/check-adr.mjs",
    "check:adr:test": "node --test scripts/check-adr.test.mjs scripts/check-adr-immutable.test.mjs",
    "check:adr:immutable": "node scripts/check-adr-immutable.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:vi-diacritics": "node scripts/check-vi-diacritics.mjs",
    "check:vi-diacritics:test": "node --test scripts/check-vi-diacritics.test.mjs",
    "check:routes:test": "node --test scripts/check-routes.test.mjs",
    "check:env-doc": "node scripts/check-env-doc.mjs",
    "check:env-doc:test": "node --test scripts/check-env-doc.test.mjs",
    "check:domains": "node scripts/check-domains.mjs",
    "check:domains:test": "node --test scripts/check-domains.test.mjs",
    "check:units": "node scripts/check-units.mjs",
    "check:units:test": "node --test scripts/check-units.test.mjs",
    "check:specs": "node scripts/check-specs.mjs",
    "check:spec-trace": "node scripts/spec-trace.mjs",
    "check:specs:test": "node --test scripts/check-specs.test.mjs scripts/spec-trace.test.mjs",
    "check:sql-safety": "node scripts/check-sql-safety.mjs",
    "check:sql-safety:test": "node --test scripts/check-sql-safety.test.mjs",
    "check:schema": "node scripts/ops/check-schema.mjs",
    "check:schema:test": "node --test scripts/ops/check-schema.test.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:migrations:test": "node --test scripts/check-migrations.test.mjs",
    "check:migrations:drift": "node scripts/check-migrations.mjs --drift",
    "depcruise": "depcruise apps/backend/src apps/backend/integration-tests apps/storefront/src packages/domain/src --config .dependency-cruiser.cjs",
    "depcruise:test": "node --test scripts/depcruise-rules.test.mjs",
    "check:ci-local": "node scripts/ci-local.mjs",
    "check:ci-local:test": "node --test scripts/ci-local.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "^9.39.5",
    "@medusajs/ui": "4.2.8",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "1.63.0",
    "@stoplight/spectral-cli": "6.17.0",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "18.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-vitest": "0.5.4",
    "globals": "17.13.0",
    "lighthouse": "13.5.0",
    "pg": "8.23.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "overrides": {
      "zod@>=4.0.0 <4.6.6": "4.6.7",
      "@graphql-codegen/plugin-helpers>lodash": "4.18.1",
      "bullmq>uuid": "11.1.1",
      "@graphql-tools/utils@<12.0.2": "12.1.0"
    }
  }
}
