{
  "name": "x-shop",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p e2e/tsconfig.json",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm -r --if-present test:integration",
    "build": "pnpm -r --if-present build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "perf:budget": "bash scripts/perf/run-budget.sh",
    "e2e": "node e2e/run.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "pg": "8.23.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
